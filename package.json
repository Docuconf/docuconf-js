{
  "name": "docuconf-js",
  "private": true,
  "description": "docuconf SDKs for JavaScript and TypeScript: @docuconf/t3, @docuconf/nestjs and their shared @docuconf/core.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/t3",
    "packages/nestjs"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "smoke": "npm run smoke --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
