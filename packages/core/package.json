{
  "name": "@docuconf/core",
  "version": "0.1.0",
  "description": "Shared runtime of the docuconf JavaScript SDKs (@docuconf/t3, @docuconf/nestjs): contract writer, file checks, violations, durations, and contract-first validation.",
  "keywords": [
    "docuconf",
    "configuration",
    "kubernetes",
    "cue",
    "contract"
  ],
  "license": "MIT",
  "homepage": "https://docuconf.dev/languages/typescript/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docuconf/docuconf-js.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/docuconf/docuconf-js/issues",
  "type": "module",
  "exports": {
    ".": {
      "@docuconf/source": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./pure": {
      "@docuconf/source": "./src/pure.ts",
      "import": {
        "types": "./dist/esm/pure.d.ts",
        "default": "./dist/esm/pure.js"
      },
      "require": {
        "types": "./dist/cjs/pure.d.ts",
        "default": "./dist/cjs/pure.js"
      }
    },
    "./loader": {
      "@docuconf/source": "./src/loader.ts",
      "types": "./dist/esm/loader.d.ts",
      "import": "./dist/esm/loader.js"
    },
    "./cli": {
      "@docuconf/source": "./src/cli.ts",
      "types": "./dist/esm/cli.d.ts",
      "import": "./dist/esm/cli.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && echo '{ \"type\": \"commonjs\" }' > dist/cjs/package.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "jiti": "^2.7.0",
    "node-forge": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "jiti": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "jiti": {
      "optional": true
    }
  }
}
