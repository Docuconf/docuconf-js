{
  // What `nest build` compiles with: legacy decorators and design types.
  // Builds against the workspace packages' dist, as an app would.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "erasableSyntaxOnly": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "customConditions": [],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
