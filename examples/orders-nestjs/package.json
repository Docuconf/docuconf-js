{
  "name": "orders-nestjs",
  "private": true,
  "description": "The docuconf orders example: a NestJS service configured with @docuconf/nestjs and @nestjs/config.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "export": "docuconf-nestjs export src/orders.config.ts --out contract.cue",
    "smoke": "bash smoke.sh",
    "check": "docuconf-nestjs export src/orders.config.ts --check contract.cue"
  },
  "dependencies": {
    "@docuconf/nestjs": "*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
