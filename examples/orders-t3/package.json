{
  "name": "orders-t3",
  "private": true,
  "description": "The docuconf orders example: a Node http service configured with @docuconf/t3, T3 Env and Zod.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "export": "docuconf-t3 export src/env.ts --out contract.cue",
    "smoke": "bash smoke.sh",
    "check": "docuconf-t3 export src/env.ts --check contract.cue"
  },
  "dependencies": {
    "@docuconf/t3": "*",
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
